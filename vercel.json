{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "cfhubuk.com" }],
      "destination": "https://www.cfhubuk.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/construction", "destination": "/api/construction" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
